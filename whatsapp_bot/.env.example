# AgriFlow WhatsApp Bot — environment variables
# Copy to .env and fill in real values for production.
# Default mock mode runs the bot end-to-end without any of these set.

# Set MOCK_MODE=false to enable real Gemini + Twilio calls
MOCK_MODE=true

# Twilio — get these from console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to true once you have a public webhook URL configured in Twilio console
TWILIO_VALIDATE_SIGNATURE=false

# Gemini — get from aistudio.google.com/app/apikey (free tier: 1500 req/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite   # 1.5 is retired; 2.5 Flash-Lite retires 2026-10-16

# Public base URL for Twilio webhook (set when deployed or after ngrok start)
PUBLIC_BASE_URL=http://localhost:8000

# --- Dashboard auth ---------------------------------------------------------
# Supabase issues the dashboard's access tokens; the API verifies them.
# Use ONE of the two schemes below.
#
#   Current projects (asymmetric ES256/RS256) — set SUPABASE_URL only. The API
#   discovers the public keys from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   and caches them. Nothing secret lives here. Preferred.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
#
#   Legacy projects (HS256 shared secret) — Supabase dashboard > Settings > API.
#   Takes precedence over SUPABASE_URL when both are set. Keep it secret.
# SUPABASE_JWT_SECRET=

# false (default) leaves the map/forecast/anomaly endpoints open so the demo
# works with no account. true makes them subscriber-only.
# /billing/status ALWAYS requires a token regardless of this flag.
REQUIRE_AUTH=false

# --- Free tier / billing ----------------------------------------------------
# Master switch for the WhatsApp paywall. OFF by default: the quota code ships
# complete and tested, but WhatsApp stays unlimited until you decide to meter.
QUOTA_ENABLED=false
# Metered WhatsApp queries a FREE sender gets per day (resets 00:00 WIB).
FREE_DAILY_QUOTA=2
PRO_PRICE_IDR=25000

# REQUIRED IN PRODUCTION. Salt for the phone-number hash. Without it the digest
# is brute-forceable over the Indonesian mobile keyspace. Generate once and keep
# it stable — changing it resets every subscriber's identity and quota.
#   python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_SALT=

# json (default, offline-safe file store) | postgres (multi-worker)
QUOTA_BACKEND=json
# QUOTA_STATE_PATH=.state/subscriptions.json

# true = no real gateway; orders settle via the demo page / "BAYAR <id>" command.
# Set false once a real payment provider is wired in.
BILLING_MOCK=true

# /chat is unmetered when called without a sender, so it bypasses the paywall.
# Set false in any deployment where that matters.
DEBUG_CHAT_ENABLED=true

# Public base URL used to build the payment link sent over WhatsApp.
PUBLIC_BASE_URL=http://localhost:8000

# --- Postgres pooling (only when QUOTA_BACKEND=postgres) --------------------
# Supabase's connection limit is per PROJECT, so your real budget is
#   workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# and it must stay under your plan's ceiling. Raise these only with a larger
# plan or pgBouncer in front.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=10

# --- Engine (v1.1) ----------------------------------------------------------
# lp (default): exact capacitated transportation optimum (scipy HiGHS).
# greedy: the v1.0 allocator.
ALLOCATOR=lp
# A (kabupaten, commodity) pair with a persistent scanner anomaly newer than
# this many days is excluded from matching (skenario D3).
ANOMALY_GATE_WINDOW_DAYS=14
# Shown in /health and /api/v1/meta when git is unavailable (HF Space build).
# AGRIFLOW_COMMIT=
